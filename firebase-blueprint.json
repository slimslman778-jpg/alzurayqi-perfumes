{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Store category",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": ["name"]
    },
    "Product": {
      "title": "Product",
      "description": "A store product",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "price": {
          "type": "number"
        },
        "categoryId": {
          "type": "string",
          "maxLength": 128
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 500
        },
        "stock": {
          "type": "number"
        }
      },
      "required": ["name", "price", "categoryId"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "customerName": {
          "type": "string",
          "maxLength": 100
        },
        "customerPhone": {
          "type": "string",
          "maxLength": 50
        },
        "customerAddress": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["pending", "processing", "shipped", "delivered", "cancelled"],
          "maxLength": 20
        },
        "totalAmount": {
          "type": "number"
        },
        "createdAt": {
          "type": "number"
        }
      },
      "required": ["customerName", "customerPhone", "customerAddress", "status", "totalAmount", "createdAt"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": {
        "$ref": "#/entities/Category"
      },
      "description": "Store categories"
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Store products"
    },
    "/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/Order"
      },
      "description": "Customer orders"
    }
  }
}
